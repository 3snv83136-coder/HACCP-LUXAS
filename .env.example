DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_APP_NAME="Sanitrace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me"

# Vercel : coller DATABASE_URL (Postgres) + SESSION_SECRET dans les variables d'environnement.
# Ne jamais laisser DATABASE_URL vide.
